# Target: Ruijie RG-EW3200GX (X32 non-pro), mediatek/mt7622
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_ruijie_rg-ew3200gx=y

# Build speed
CONFIG_CCACHE=y

# LuCI + 中文界面
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# DNS：smartdns + dnsmasq-full（沿用旧版特性）
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# 透明代理：PassWall2 所需的 nftables 内核模块
# 缺这两个模块时 LuCI 会提示“缺少组件，透明代理不可用”，
# 日志报 “socket transparent 1 / tproxy” 规则加载失败。
# 内核模块必须编进固件，无法运行时安装或 insmod。
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
